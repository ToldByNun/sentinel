@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(CUDAToolkit REQUIRED)
find_dependency(Threads REQUIRED)
# Bundled static zlib is the default build; only system builds need ZLIB here.
if(@SENTINEL_SYSTEM_ZLIB@)
    find_dependency(ZLIB REQUIRED)
endif()
find_dependency(OpenMP)

include("${CMAKE_CURRENT_LIST_DIR}/SentinelTargets.cmake")

check_required_components(Sentinel)
